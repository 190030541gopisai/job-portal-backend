
pipeline {
    agent any
    parameters {
        choice(name: 'VERSION', choices: ['1.1.0', '1.2.0', '1.3.0'], description: 'Version for demo')
        booleanParam(name: 'executeTests', defaultValue: true, description: 'Execute tests for demo')
    }
    stages {
        stage('Build') {
            steps {
                echo 'Building the code...'
            }
        }
       stage('Test') {
            when {
                expression {
                    params.executeTests == true
                }
            }
            steps {
                echo 'Testing the code...'
            }
        }
       stage('Deploy') {
            steps {
                echo 'Deploying the code...'
                echo "Deploying version ${params.version}"
            }
        }
    }
}
