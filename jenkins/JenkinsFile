def gv

pipeline {
    agent any
    parameters {
        choice(name: 'VERSION', choices: ['1.1.0', '1.2.0', '1.3.0'], description: 'Version for demo')
        booleanParam(name: 'executeTests', defaultValue: true, description: 'Execute tests for demo')
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load 'jenkins/scripts/script.groovy'
                }
            }
        }
        stage('Build') {
            steps {
                script{
                    gv.buildApp()
                }
            }
        }
       stage('Test') {
            when {
                expression {
                    params.executeTests == true
                }
            }
            steps {
                script{
                    gv.testApp()
                }
            }
        }
       stage('Deploy') {
            input {
                message 'Select the environment to deploy to'
                ok "Done"
                parameters {
                    choice(name: 'ENV', choices: ['dev', 'staging', 'prod'], description:'Environment choices')
                }
            }
            steps {
               script {
                gv.deployApp()
                echo "Deploying to ${ENV}"
               }
            }
        }
    }
}
