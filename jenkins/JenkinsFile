def gv

pipeline {
    agent any
    parameters {
        choice(name: 'VERSION', choices: ['1.1.0', '1.2.0', '1.3.0'], description: 'Version for demo')
        booleanParam(name: 'executeTests', defaultValue: true, description: 'Execute tests for demo')
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load 'scripts/script.groovy'
                }
            }
        }
        stage('Build') {
            steps {
                script{
                    gv.buildApp()
                }
            }
        }
       stage('Test') {
            when {
                expression {
                    params.executeTests == true
                }
            }
            steps {
                script{
                    gv.testApp()
                }
            }
        }
       stage('Deploy') {
            steps {
               script {
                gv.deployApp()
               }
            }
        }
    }
}
